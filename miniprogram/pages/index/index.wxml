<view class="app">
  <view class="header">📦 打包录像</view>
  <view class="status {{connected?'ok':'err'}}">{{statusText}}</view>

  <!-- Tracking -->
  <view class="card">
    <view class="label">快递单号</view>
    <input class="tracking" value="{{tracking}}" placeholder="扫码自动填入" bindinput="onTrackingInput"/>
  </view>

  <!-- Actions -->
  <button class="btn btn-blue" bindtap="doScan" disabled="{{scanning}}">{{scanBtn}}</button>
  <button class="btn btn-red" bindtap="doRecord" disabled="{{!tracking}}" wx:if="{{!videoReady}}">⏺ 开始录像</button>
  <button class="btn btn-green" bindtap="doUpload" disabled="{{!videoReady||uploading}}" wx:if="{{videoReady}}">☁️ 上传到电脑</button>
  <button class="btn btn-purple" bindtap="doNext" wx:if="{{done}}">✅ 下一单</button>
  <view class="info" wx:if="{{videoPath}}">已录: {{videoPath}}</view>
</view>
